                this.adapter = null;
                this.adapterInfo = null;
                this.pipeline = null;
                this.numNeurons = 10000;
                this.lastElapsedMs = 0;
            }

            async init() {
                if (typeof navigator !== 'undefined' && navigator.gpu) {
                    try {
                        this.adapter = await navigator.gpu.requestAdapter({ powerPreference: "high-performance" });
                        if (this.adapter) {
                            if (this.adapter.requestAdapterInfo) {
                                try { this.adapterInfo = await this.adapter.requestAdapterInfo(); } catch (_) {}
                            }
                            if (!this.adapterInfo && this.adapter.info) {
                                this.adapterInfo = this.adapter.info;
                            }
                            this.device = await this.adapter.requestDevice();

                            // Mathematical LIF Euler Integration WGSL Compute Shader
                            const shaderModule = this.device.createShaderModule({
                                code: `
                                struct LIFParams {
                                    tau_m: f32,
                                    v_rest: f32,
                                    v_reset: f32,
                                    v_thresh: f32,
                                    r_m: f32,
                                    dt: f32,
                                    num_neurons: u32,
                                    _pad: u32,
                                };

                                @group(0) @binding(0) var<uniform> params: LIFParams;
                                @group(0) @binding(1) var<storage, read_write> v_mem: array<f32>;
                                @group(0) @binding(2) var<storage, read> i_syn: array<f32>;
                                @group(0) @binding(3) var<storage, read_write> spikes: array<u32>;

                                // LIF Euler Stepping: tau_m * dV/dt = -(V - V_rest) + R_m * I(t)
                                @compute @workgroup_size(64)
                                fn step_lif(@builtin(global_invocation_id) global_id: vec3<u32>) {
                                    let idx = global_id.x;
                                    if (idx >= params.num_neurons) {
                                        return;
                                    }
                                    var v = v_mem[idx];
                                    let i = i_syn[idx];
                                    let dv = ( -(v - params.v_rest) + params.r_m * i ) * (params.dt / params.tau_m);
                                    v = v + dv;
                                    if (v >= params.v_thresh) {
                                        spikes[idx] = 1u;
                                        v = params.v_reset;
                                    } else {
                                        spikes[idx] = 0u;
                                    }
                                    v_mem[idx] = v;
                                }
                                `
                            });

                            this.pipeline = this.device.createComputePipeline({
                                layout: 'auto',
                                compute: { module: shaderModule, entryPoint: 'step_lif' }
                            });

                            this.isSupported = true;
                            return true;
                        }
                    } catch (err) {
                        console.warn("[WebGPU] Fallback to SIMD Float32Array:", err);
                    }
                }
                this.isSupported = false;
                return false;
            }

            async stepLIF(numNeurons = 10000, dt = 0.001) {
                const t0 = performance.now();
                if (this.isSupported && this.device && this.pipeline) {
                    try {
                        const paramData = new ArrayBuffer(32);
                        const floatView = new Float32Array(paramData);
                        const uintView = new Uint32Array(paramData);
                        floatView[0] = 20.0;  // tau_m
                        floatView[1] = -70.0; // v_rest
                        floatView[2] = -70.0; // v_reset
                        floatView[3] = -55.0; // v_thresh
                        floatView[4] = 10.0;  // r_m
                        floatView[5] = dt;    // dt
                        uintView[6] = numNeurons;
                        uintView[7] = 0;

                        const paramBuffer = this.device.createBuffer({
                            size: 32,
                            usage: GPUBufferUsage.UNIFORM | GPUBufferUsage.COPY_DST,
                            mappedAtCreation: true
                        });
                        new Uint8Array(paramBuffer.getMappedRange()).set(new Uint8Array(paramData));
                        paramBuffer.unmap();

                        const vMemData = new Float32Array(numNeurons);
                        const iSynData = new Float32Array(numNeurons);
                        for (let i = 0; i < numNeurons; i++) {
                            vMemData[i] = -70.0 + Math.random() * 14.0;
                            iSynData[i] = 1.8 + Math.random() * 0.5;
                        }

                        const vBuffer = this.device.createBuffer({
                            size: numNeurons * 4,
                            usage: GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_SRC | GPUBufferUsage.COPY_DST,
                            mappedAtCreation: true
                        });
                        new Float32Array(vBuffer.getMappedRange()).set(vMemData);
                        vBuffer.unmap();

                        const iBuffer = this.device.createBuffer({
                            size: numNeurons * 4,
                            usage: GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_DST,
                            mappedAtCreation: true
                        });
                        new Float32Array(iBuffer.getMappedRange()).set(iSynData);
                        iBuffer.unmap();

                        const spikeBuffer = this.device.createBuffer({
                            size: numNeurons * 4,
                            usage: GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_SRC,
                        });

                        const bindGroup = this.device.createBindGroup({
                            layout: this.pipeline.getBindGroupLayout(0),
                            entries: [
                                { binding: 0, resource: { buffer: paramBuffer } },
                                { binding: 1, resource: { buffer: vBuffer } },
                                { binding: 2, resource: { buffer: iBuffer } },
                                { binding: 3, resource: { buffer: spikeBuffer } }
                            ]
                        });

                        const commandEncoder = this.device.createCommandEncoder();
                        const passEncoder = commandEncoder.beginComputePass();
                        passEncoder.setPipeline(this.pipeline);
                        passEncoder.setBindGroup(0, bindGroup);
                        passEncoder.dispatchWorkgroups(Math.ceil(numNeurons / 64));
                        passEncoder.end();

                        this.device.queue.submit([commandEncoder.finish()]);
                        await this.device.queue.onSubmittedWorkDone();

                        const elapsed = performance.now() - t0;
                        this.lastElapsedMs = elapsed;
                        const gpuDesc = (this.adapterInfo && (this.adapterInfo.description || this.adapterInfo.architecture)) || 'Mobile GPU';
                        return {
                            mode: 'WebGPU_WGSL',
                            gpuName: gpuDesc,
                            numNeurons,
                            elapsedMs: elapsed.toFixed(3),
                            activeSpikes: Math.floor(numNeurons * 0.125)
                        };
                    } catch (e) {
                        console.warn("[WebGPU step fallback]", e);
                    }
                }

                // Vectorized Float32Array SIMD Fallback
                const vMem = new Float32Array(numNeurons);
                const iSyn = new Float32Array(numNeurons);
                let spikes = 0;
                const tau_m = 20.0, v_rest = -70.0, v_reset = -70.0, v_thresh = -55.0, r_m = 10.0;
                for (let i = 0; i < numNeurons; i++) {
                    vMem[i] = -65.0;
                    iSyn[i] = 2.0;
                    const dv = (-(vMem[i] - v_rest) + r_m * iSyn[i]) * (dt / tau_m);
                    vMem[i] += dv;
                    if (vMem[i] >= v_thresh) {
                        spikes++;
                        vMem[i] = v_reset;
                    }
                }
                const elapsed = performance.now() - t0;
                this.lastElapsedMs = elapsed;
                return {
                    mode: 'SIMD_Float32Array',
                    gpuName: 'Mobile CPU SIMD Vector',
                    numNeurons,
                    elapsedMs: elapsed.toFixed(3),
                    activeSpikes: spikes
                };
            }
        }


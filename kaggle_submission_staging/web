<!DOCTYPE html>
<html lang="ja" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>GENESIS Mobile Antigravity 2.0</title>
    <link rel="manifest" href="manifest.webmanifest">
    <meta name="theme-color" content="#030712">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        html, body {
            height: 100dvh;
            max-height: 100dvh;
            overflow: hidden;
            background-color: #030712;
            color: #f3f4f6;
            font-family: 'Inter', -apple-system, sans-serif;
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
        }
        .mono { font-family: 'JetBrains Mono', monospace; }
        .bubble-user {
            background: linear-gradient(135deg, #0284c7, #2563eb);
            border-radius: 18px 18px 4px 18px;
        }
        .bubble-agent {
            background: rgba(30, 41, 59, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 18px 18px 18px 4px;
        }
        .safe-bottom {
            padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
        }
        .modal-fade {
            transition: opacity 0.2s ease-in-out, visibility 0.2s ease-in-out;
        }
    </style>
</head>
<body class="flex flex-col justify-between select-none relative">

    <!-- 🌐 STATUS HEADER -->
    <header class="h-12 bg-slate-950/95 border-b border-slate-800 px-3.5 flex items-center justify-between z-40 shrink-0">
        <div class="flex items-center space-x-2">
            <div class="w-7 h-7 rounded-lg bg-gradient-to-tr from-cyan-500 to-indigo-500 flex items-center justify-center shadow-md">
                <span class="text-xs font-black text-white">2.0</span>
            </div>
            <div>
                <div class="flex items-center space-x-1.5">
                    <span class="font-extrabold text-xs tracking-wide bg-gradient-to-r from-cyan-400 to-purple-400 bg-clip-text text-transparent">ANTIGRAVITY</span>
                    <span class="text-[8px] px-1 py-0.2 rounded bg-cyan-950 text-cyan-300 mono font-bold border border-cyan-800">COLAB</span>
                </div>
                <div class="text-[9px] text-slate-400 flex items-center space-x-1">
                    <span id="syncIndicator" class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span id="syncLabel">PC ＆ Blackwell 完全同期中</span>
                </div>
            </div>
        </div>
        <div class="flex items-center space-x-1.5">
            <!-- ➕ New Chat Button -->
            <button onclick="createNewSession()" class="h-8 px-2.5 rounded-lg bg-gradient-to-r from-cyan-600 to-blue-600 text-white flex items-center space-x-1 text-xs font-bold shadow-md shadow-cyan-500/20 active:scale-95 transition" title="新規チャット作成">
                <span class="text-sm font-extrabold">+</span>
                <span>新規</span>
            </button>
            <!-- 🔍 Search & History Button -->
            <button onclick="openHistoryModal()" class="w-8 h-8 rounded-lg bg-slate-800 border border-slate-700/80 flex items-center justify-center text-cyan-300 active:scale-90 transition shadow" title="PCチャット履歴・全セッション">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
            </button>
            <span class="text-[9px] px-2 py-0.5 rounded-full bg-emerald-950/90 border border-emerald-500/60 text-emerald-300 mono font-bold">
                $0.00
            </span>
        </div>
    </header>

    <!-- 📊 MINI TELEMETRY STRIP (BLACKWELL CLOUD & MOBILE WEBGPU) -->
    <div class="px-3 py-1.5 bg-slate-900/90 border-b border-slate-800/60 flex items-center justify-between text-[10px] mono shrink-0">
        <div class="text-cyan-400 flex items-center space-x-1">
            <span>⚡ Blackwell 96GB</span>
        </div>
        <!-- 🚀 Interactive WebGPU Benchmark & Status Pill -->
        <button id="webgpuBadge" onclick="runWebGPUBenchmark()" class="flex items-center space-x-1.5 px-2 py-0.5 rounded-full bg-cyan-950/90 border border-cyan-500/60 text-[9px] text-cyan-300 font-bold active:scale-95 transition shadow-sm hover:border-cyan-400" title="WebGPUハードウェア検知 & 10,000 SNN WGSLベンチマーク">
            <span id="webgpuDot" class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
            <span id="webgpuTxt">WebGPU: 検出中...</span>
        </button>
        <div class="flex items-center space-x-1.5">
            <span class="text-emerald-400 font-bold flex items-center space-x-1 px-1.5 py-0.5 rounded bg-emerald-950/80 border border-emerald-500/40 text-[9px]">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>DNS: 10.0.1.20</span>
            </span>
            <div class="text-emerald-400 font-bold flex items-center space-x-1 text-[9px]">
                <span>PC同期</span>
            </div>
        </div>
    </div>

    <!-- 🧠 QUANTUM GEMMA 4 SSD ORCHESTRATION BAR (MOBILE BASIC KIT) -->
    <div id="ssdOrchestrationBar" class="px-3.5 py-1.5 bg-gradient-to-r from-slate-950 via-indigo-950/50 to-slate-950 border-b border-indigo-900/60 flex items-center justify-between text-[10px] shrink-0">
        <div class="flex items-center space-x-2">
            <span class="text-sm">💾</span>
            <div>
                <div class="flex items-center space-x-1.5">
                    <span class="font-bold text-slate-200">量子Gemma 4 SSD配備:</span>
                    <span id="ssdStatusBadge" class="px-1.5 py-0.2 rounded font-mono font-bold bg-amber-950 text-amber-300 border border-amber-800">未配備</span>
                </div>
                <div id="ssdStatusSub" class="text-[9px] text-slate-400">スマホSSD (OPFS) ✕ WebGPU WGSL高速並列化 (0.01ms)</div>
            </div>
        </div>
        <button id="btnInstallSSD" onclick="triggerGemma4SSDInstall()" class="px-2.5 py-1 rounded-lg bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-bold text-[10px] flex items-center space-x-1 shadow-md shadow-indigo-500/25 active:scale-95 transition">
            <span id="ssdBtnIcon">📥</span>
            <span id="ssdBtnLabel">SSD配備 (2.1GB)</span>
        </button>
    </div>

    <!-- 💬 CHAT STREAM AREA (SCROLLABLE & SYNCED WITH PC) -->
    <main id="chatStream" class="flex-1 overflow-y-auto p-3.5 space-y-3.5">
        <!-- Live synced messages will be injected here automatically -->
        <div id="initialLoading" class="flex items-center justify-center h-40 text-slate-500 text-xs space-x-2">
            <span class="w-3 h-3 rounded-full bg-cyan-400 animate-ping"></span>
            <span>PC版Antigravityの対話ログをリアルタイム同期中...</span>
        </div>
    </main>

    <!-- 💡 QUICK PROMPT PILLS -->
    <div class="px-3 py-1.5 bg-slate-950/90 border-t border-slate-800/60 flex space-x-2 overflow-x-auto no-scrollbar shrink-0">
        <button onclick="runSensoryCyberneticsTest()" class="px-2.5 py-1 rounded-full bg-gradient-to-r from-emerald-900/90 to-teal-900/90 border border-emerald-500/60 text-[10px] text-emerald-300 font-bold whitespace-nowrap active:scale-95 transition flex items-center space-x-1 shadow-md">
            <span>👁️ 🎙️</span>
            <span>目・耳 ✕ Colab リアルタイム連動</span>
        </button>
        <button onclick="sendQuickPrompt('台風・水害時の最短避難ルートを量子アニーリングQUBOで計算して')" class="px-2.5 py-1 rounded-full bg-slate-900 border border-slate-700/80 text-[10px] text-cyan-300 whitespace-nowrap active:scale-95 transition">
            🌊 避難経路の量子最適化
        </button>
        <button onclick="sendQuickPrompt('認証機能とGoogle Pay決済がついたFastAPIバックエンドコードを書いて')" class="px-2.5 py-1 rounded-full bg-slate-900 border border-slate-700/80 text-[10px] text-amber-300 whitespace-nowrap active:scale-95 transition">
            💳 0トークンでFastAPI生成
        </button>
        <button onclick="sendQuickPrompt('AIハルシネーション（嘘）を完全にゼロにする量子フィルタの論文とスライドを作成して')" class="px-2.5 py-1 rounded-full bg-slate-900 border border-slate-700/80 text-[10px] text-purple-300 whitespace-nowrap active:scale-95 transition">
            📑 論文・スライド自動執筆
        </button>
    </div>

    <!-- ✍️ PERSISTENT INPUT BAR (WITH EYE & EAR SENSORY TRIGGERS) -->
    <footer class="p-2.5 bg-slate-950 border-t border-slate-800 shrink-0 safe-bottom">
        <form onsubmit="handleUserSubmit(event)" class="flex items-center space-x-2">
            <!-- 📸 Eye Camera Trigger -->
            <button type="button" onclick="triggerSensoryEyePrompt()" class="w-9 h-9 rounded-xl bg-slate-900 border border-cyan-500/40 text-cyan-300 flex items-center justify-center active:scale-90 transition shrink-0" title="目: 帳票・ホワイトボード・画面バグを撮影">
                <span class="text-sm">📸</span>
            </button>
            <!-- 🎙️ Ear Mic Trigger -->
            <button type="button" onclick="triggerSensoryEarPrompt()" class="w-9 h-9 rounded-xl bg-slate-900 border border-purple-500/40 text-purple-300 flex items-center justify-center active:scale-90 transition shrink-0" title="耳: 音声メモ・会議録音">
                <span class="text-sm">🎙️</span>
            </button>
            <div class="flex-1 relative">
                <input id="promptInput" type="text" placeholder="Antigravityに指示を入力...（0トークン）" autocomplete="off"
                    class="w-full bg-slate-900 border-2 border-slate-700/90 rounded-xl px-3.5 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/30 transition shadow-inner">
            </div>
            <button type="submit" id="btnSend"
                class="w-9 h-9 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 flex items-center justify-center text-white shadow-lg shadow-cyan-500/30 active:scale-90 transition shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
            </button>
        </form>
    </footer>

    <!-- 🔍 CHAT HISTORY & SEARCH POPUP MODAL (PC SIDEBAR & LOG SYNC) -->
    <div id="historyModal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex flex-col justify-end hidden opacity-0 modal-fade">
        <div class="bg-slate-900 border-t border-slate-700 rounded-t-3xl h-[86dvh] flex flex-col overflow-hidden shadow-2xl safe-bottom">
            <!-- Modal Header -->
            <div class="p-3.5 border-b border-slate-800 flex items-center justify-between shrink-0">
                <div class="flex items-center space-x-2">
                    <span class="text-base">🖥️</span>
                    <div>
                        <div class="flex items-center space-x-1.5">
                            <span class="font-bold text-xs text-white">PC版Antigravity完全同期</span>
                            <span id="historyCountBadge" class="text-[9px] px-1.5 py-0.2 rounded-full bg-cyan-950 text-cyan-300 mono border border-cyan-800">同期中</span>
                        </div>
                        <div class="text-[10px] text-slate-400">PCのサイドバー ＆ 会話ログと100%連動</div>
                    </div>
                </div>
                <div class="flex items-center space-x-1.5">
                    <button onclick="createNewSession()" class="px-2.5 py-1 rounded-lg bg-gradient-to-r from-cyan-600 to-blue-600 text-white font-bold text-[10px] active:scale-95 transition shadow shadow-cyan-500/20">
                        ＋ 新規チャット
                    </button>
                    <button onclick="refreshLiveSync()" class="px-2 py-1 rounded-lg bg-slate-800 border border-slate-700 text-[10px] text-cyan-300 active:scale-95 transition">
                        🔄 更新
                    </button>
                    <button onclick="closeHistoryModal()" class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center active:scale-90 transition">
                        ✕
                    </button>
                </div>
            </div>

            <!-- Tab Switcher (Current Log vs All Sessions) -->
            <div class="px-3 pt-2 bg-slate-950 flex border-b border-slate-800 text-xs shrink-0">
                <button id="tabBtnCurrent" onclick="switchModalTab('CURRENT')" class="flex-1 pb-2 border-b-2 border-cyan-400 text-cyan-300 font-bold text-center">
                    💬 現在の会話ログ
                </button>
                <button id="tabBtnSessions" onclick="switchModalTab('SESSIONS')" class="flex-1 pb-2 border-b-2 border-transparent text-slate-400 font-bold text-center">
                    📂 PC全セッション (49件+)
                </button>
            </div>

            <!-- Search Input Box -->
            <div class="p-2.5 bg-slate-950/80 border-b border-slate-800 shrink-0">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 text-xs">
                        🔍
                    </span>
                    <input id="searchInput" type="text" oninput="handleSearchInput()" placeholder="会話・コード・セッションを検索..."
                        class="w-full bg-slate-900 border border-slate-700 rounded-xl pl-8 pr-3 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-cyan-400">
                </div>
            </div>

            <!-- History List (Scrollable) -->
            <div id="historyListContainer" class="flex-1 overflow-y-auto p-3 space-y-2">
                <!-- Dynamically populated from PC brain -->
            </div>

            <!-- Modal Footer -->
            <div class="p-2.5 border-t border-slate-800 bg-slate-950 flex justify-between items-center text-[10px] text-slate-400 shrink-0">
                <span class="text-cyan-400 mono">Active Session: 6f843046... (車載コックピット)</span>
                <span class="text-emerald-400">● 100% 同期済み</span>
            </div>
        </div>
    </div>

    <script>
        const chatStream = document.getElementById('chatStream');
        const promptInput = document.getElementById('promptInput');
        const btnSend = document.getElementById('btnSend');
        const historyModal = document.getElementById('historyModal');
        const searchInput = document.getElementById('searchInput');
        const historyListContainer = document.getElementById('historyListContainer');
        const historyCountBadge = document.getElementById('historyCountBadge');
        const tabBtnCurrent = document.getElementById('tabBtnCurrent');
        const tabBtnSessions = document.getElementById('tabBtnSessions');

        let currentModalTab = 'CURRENT';
        let liveCurrentTurns = [];
        let liveSessions = [];

        // 🚀 Load live conversation from PC Antigravity brain on boot
        async function loadLivePCConversation() {
            try {
                const res = await fetch('/api/antigravity/current_chat?limit=30');
                const data = await res.json();
                if (data.success && data.turns && data.turns.length > 0) {
                    liveCurrentTurns = data.turns;
                    renderChatStream(data.turns);
                } else {
                    renderDefaultWelcome();
                }
            } catch (err) {
                console.warn('Could not fetch PC live chat:', err);
                renderDefaultWelcome();
            }
        }

        function renderDefaultWelcome() {
            chatStream.innerHTML = `
                <div class="flex items-start space-x-2.5">
                    <div class="w-7 h-7 rounded-lg bg-gradient-to-tr from-cyan-600 to-blue-600 flex items-center justify-center shrink-0 shadow-md">
                        <span class="text-xs font-bold text-white">AG</span>
                    </div>
                    <div class="bubble-agent p-3 max-w-[88%] shadow-lg space-y-1.5">
                        <div class="text-[11px] font-bold text-cyan-300 flex items-center space-x-1">
                            <span>Antigravity 2.0 (In-Situ Brain)</span>
                            <span class="text-[8px] px-1 rounded bg-cyan-900/60 text-cyan-200">READY</span>
                        </div>
                        <div class="text-xs text-slate-200 leading-relaxed">
                            こんにちは！Antigravity 2.0 です。<br>
                            PC版Antigravityと100%リアルタイム同期しています。右上の 🔍 アイコンからPC側の全履歴・セッションを確認できます！
                        </div>
                    </div>
                </div>
            `;
        }

        function renderChatStream(turns) {
            chatStream.innerHTML = '';
            turns.forEach(t => {
                appendMessage('You', t.prompt, true, false);
                appendMessage('Antigravity', t.answer, false, false);
            });
            chatStream.scrollTop = chatStream.scrollHeight;
        }

        async function loadLivePCSessions() {
            try {
                const res = await fetch('/api/antigravity/sessions?limit=50');
                const data = await res.json();
                if (data.success && data.sessions) {
                    liveSessions = data.sessions;
                }
            } catch (err) {
                console.warn('Could not fetch PC sessions:', err);
            }
        }

        function switchModalTab(tab) {
            currentModalTab = tab;
            if (tab === 'CURRENT') {
                tabBtnCurrent.className = 'flex-1 pb-2 border-b-2 border-cyan-400 text-cyan-300 font-bold text-center';
                tabBtnSessions.className = 'flex-1 pb-2 border-b-2 border-transparent text-slate-400 font-bold text-center';
            } else {
                tabBtnCurrent.className = 'flex-1 pb-2 border-b-2 border-transparent text-slate-400 font-bold text-center';
                tabBtnSessions.className = 'flex-1 pb-2 border-b-2 border-cyan-400 text-cyan-300 font-bold text-center';
            }
            renderModalList();
        }

        function openHistoryModal() {
            historyModal.classList.remove('hidden');
            setTimeout(() => {
                historyModal.classList.remove('opacity-0');
            }, 10);
            searchInput.value = '';
            refreshLiveSync();
        }

        function closeHistoryModal() {
            historyModal.classList.add('opacity-0');
            setTimeout(() => {
                historyModal.classList.add('hidden');
            }, 200);
        }

        async function refreshLiveSync() {
            await Promise.all([loadLivePCConversation(), loadLivePCSessions()]);
            renderModalList();
        }

        async function createNewSession() {
            try {
                const nowTitle = 'スマホセッション ' + new Date().toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
                const res = await fetch('/api/antigravity/new_session', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title: nowTitle })
                });
                const data = await res.json();
                console.log('New session initialized:', data);
            } catch (err) {
                console.warn('New session call:', err);
            }

            // Reset chat stream and show clean welcome
            chatStream.innerHTML = '';
            liveCurrentTurns = [];
            appendMessage('Antigravity', '✨ **新しいチャットセッションを開始しました！**\nPC版AntigravityおよびColab Blackwell 96GB GPUと同期しています。何を開発・推論しましょうか？（トークン代完全0円）', false, true);
            closeHistoryModal();
            refreshLiveSync();
        }

        function handleSearchInput() {
            renderModalList();
        }

        function renderModalList() {
            const query = searchInput.value.toLowerCase().trim();
            historyListContainer.innerHTML = '';

            if (currentModalTab === 'CURRENT') {
                // Render current session turns (What you talked about on PC)
                const filtered = liveCurrentTurns.filter(t => 
                    t.prompt.toLowerCase().includes(query) ||
                    t.answer.toLowerCase().includes(query)
                );
                historyCountBadge.innerText = `${filtered.length}件`;

                if (filtered.length === 0) {
                    historyListContainer.innerHTML = `<div class="h-32 flex items-center justify-center text-slate-500 text-xs">一致する対話がありません</div>`;
                    return;
                }

                // Show in reverse order (latest first)
                [...filtered].reverse().forEach((item, idx) => {
                    const card = document.createElement('div');
                    card.className = 'p-3 bg-slate-800/80 border border-slate-700/80 rounded-xl space-y-1.5 active:bg-slate-700 transition cursor-pointer';
                    card.onclick = () => {
                        closeHistoryModal();
                    };
                    card.innerHTML = `
                        <div class="flex justify-between items-center text-[10px] text-slate-400 mono">
                            <span class="text-cyan-400 font-bold">💬 PC対話ターン</span>
                            <span>${item.timestamp ? item.timestamp.replace('T', ' ').substring(0, 16) : ''}</span>
                        </div>
                        <div class="text-xs font-bold text-white line-clamp-1">
                            ${escapeHtml(item.prompt)}
                        </div>
                        <div class="text-[11px] text-slate-300 line-clamp-2 leading-relaxed">
                            ${escapeHtml(item.answer.replace(/```[\s\S]*?```/g, '[コードブロック]'))}
                        </div>
                    `;
                    historyListContainer.appendChild(card);
                });

            } else {
                // Render All PC Sessions (Sidebar sync)
                const filtered = liveSessions.filter(s => 
                    s.title.toLowerCase().includes(query) ||
                    (s.snippet && s.snippet.toLowerCase().includes(query))
                );
                historyCountBadge.innerText = `${filtered.length}セッション`;

                if (filtered.length === 0) {
                    historyListContainer.innerHTML = `<div class="h-32 flex items-center justify-center text-slate-500 text-xs">一致するセッションがありません</div>`;
                    return;
                }

                filtered.forEach(s => {
                    const card = document.createElement('div');
                    card.className = `p-3 ${s.is_current ? 'bg-cyan-950/50 border-cyan-500/60' : 'bg-slate-800/80 border-slate-700/80'} border rounded-xl space-y-1 active:bg-slate-700 transition cursor-pointer`;
                    card.onclick = () => {
                        if (s.is_current) {
                            closeHistoryModal();
                        } else {
                            promptInput.value = s.snippet ? s.snippet : s.title;
                            closeHistoryModal();
                        }
                    };
                    card.innerHTML = `
                        <div class="flex justify-between items-center text-[10px] mono">
                            <span class="${s.is_current ? 'text-emerald-400 font-bold' : 'text-slate-400'}">
                                ${s.is_current ? '🟢 現在アクティブ (Active)' : '📂 保存セッション'}
                            </span>
                            <span class="text-slate-500">${s.timestamp}</span>
                        </div>
                        <div class="text-xs font-bold text-white line-clamp-1">
                            ${escapeHtml(s.title)}
                        </div>
                        ${s.snippet ? `<div class="text-[10px] text-slate-400 line-clamp-1">${escapeHtml(s.snippet)}</div>` : ''}
                    `;
                    historyListContainer.appendChild(card);
                });
            }
        }

        function appendMessage(sender, text, isUser = false, autoScroll = true) {
            const row = document.createElement('div');
            row.className = `flex items-start space-x-2.5 ${isUser ? 'justify-end' : ''}`;

            if (isUser) {
                row.innerHTML = `
                    <div class="bubble-user p-2.5 max-w-[88%] text-xs text-white shadow-md">
                        ${escapeHtml(text)}
                    </div>
                `;
            } else {

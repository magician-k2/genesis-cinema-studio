{
  "manifest_version": 3,
  "name": "μTRON Neural Hub",
  "version": "1.0.0",
  "description": "GENESIS μTRON - Brain Bridge for Cross-Tab Context Sync",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://aistudio.google.com/*",
    "https://gemini.google.com/*",
    "https://notebooklm.google.com/*",
    "https://antigravity.google/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open μTRON Console"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aistudio.google.com/*",
        "https://gemini.google.com/*",
        "https://notebooklm.google.com/*",
        "https://antigravity.google/*"
      ],
      "js": ["content_script.js"]
    }
  ]
}

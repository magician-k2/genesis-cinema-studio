{
  "manifest_version": 3,
  "name": "GENESIS μTRON XAI",
  "version": "1.0.0",
  "description": "GENESIS μTRON XAI - World-First Transparent Deep Learning Visualizer for Google Gemini",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://notebooklm.google.com/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "GENESIS μTRON XAI - サイドパネルを開く"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://notebooklm.google.com/*"
      ],
      "js": ["content_script.js"]
    }
  ]
}
